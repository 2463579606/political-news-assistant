# Database
DATABASE_URL=postgresql://user:password@localhost:5432/political_news

# Redis
REDIS_URL=redis://localhost:6379

# API Keys (User will provide their own)
# CLAUDE_API_KEY=sk-ant-xxx

# Tushare API (行情数据)
# 获取Token: https://tushare.pro/register
TUSHARE_TOKEN=your_tushare_token_here

# News API
NEWS_API_KEY=your_newsapi_key_here
NEWS_API_BASE_URL=https://newsapi.org/v2

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000

# Encryption (Use a strong secret key)
ENCRYPTION_KEY=your_32_char_encryption_key_here

# JWT (Optional - if using authentication)
JWT_SECRET=your_jwt_secret_here
